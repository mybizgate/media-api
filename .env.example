# MyBizGate Media API — environment template
#
# One template for every environment. Section A holds the only values that
# differ between local development and production; sections B and C are the
# same everywhere. Production's copy lives at /home/mybizgat/app/media-api/.env,
# is server-managed and is never uploaded by the deploy workflow.
#
# Local:      cp .env.example .env && php artisan key:generate
# Production: copy this file, apply the "production:" values in section A,
#             generate APP_KEY once (php artisan key:generate --show) and never
#             change it afterwards.
#
# This service has no database: do not add DB_* settings.

# ---------------------------------------------------------------------------
# A. Environment-specific
# ---------------------------------------------------------------------------
APP_NAME="MyBizGate Media API"

# production: APP_ENV=production   (the deploy health check asserts this)
APP_ENV=local

# production: APP_DEBUG=false      (debug pages would expose paths and config)
APP_DEBUG=true

# Forced as the root URL, so every view_url/thumbnail_url is built from it.
# production: APP_URL=https://media-api.mybizgate.com
APP_URL=http://127.0.0.1:8001

# Generated per environment; the production key must never be regenerated.
APP_KEY=

# Absolute path outside the application and outside the public web root.
# production: MEDIA_STORAGE_PATH=/home/mybizgat/data/media-api/uploads
MEDIA_STORAGE_PATH=/home/jul/Workspace/mybizgate/uploads/media-api

# production: LOG_LEVEL=warning
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# B. Same in every environment
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
APP_MAINTENANCE_DRIVER=file

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ---------------------------------------------------------------------------
# C. Media processing (optional; these are the config/media.php defaults)
# ---------------------------------------------------------------------------
MEDIA_IMAGE_MAX_WIDTH=1600
MEDIA_IMAGE_MAX_HEIGHT=1600
MEDIA_IMAGE_WEBP_QUALITY=80
MEDIA_IMAGE_ALLOW_AVIF=true

MEDIA_THUMB_MAX_WIDTH=400
MEDIA_THUMB_MAX_HEIGHT=400
MEDIA_THUMB_WEBP_QUALITY=75

MEDIA_IMAGE_MAX_SIZE_KB=10240
MEDIA_FILE_MAX_SIZE_KB=25600

# Extra CORS origins, comma separated. localhost:5173 and every
# https://*.mybizgate.com origin are allowed without listing them.
MEDIA_CORS_ORIGINS=
