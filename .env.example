APP_NAME="MyBizGate Media API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The media service does not use a database; sqlite is only the framework default.
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Media storage (outside the application and outside the public web root)
# Local:      /home/jul/Workspace/mybizgate/uploads/media-api
# Production: /home/mybizgat/data/media-api/uploads
# ---------------------------------------------------------------------------
MEDIA_STORAGE_PATH=/home/jul/Workspace/mybizgate/uploads/media-api

MEDIA_IMAGE_MAX_WIDTH=1600
MEDIA_IMAGE_MAX_HEIGHT=1600
MEDIA_IMAGE_WEBP_QUALITY=80

MEDIA_THUMB_MAX_WIDTH=400
MEDIA_THUMB_MAX_HEIGHT=400
MEDIA_THUMB_WEBP_QUALITY=75

MEDIA_IMAGE_MAX_SIZE_KB=10240
MEDIA_FILE_MAX_SIZE_KB=25600

# Extra CORS origins, comma separated (tenant subdomains are allowed automatically).
MEDIA_CORS_ORIGINS=
