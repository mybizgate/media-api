# Laravel runtime (also guarded by the nested .gitignore files).
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*

# Deployment: the release package built by GitHub Actions and the
# non-secret deployment identity it writes (see .github/workflows/deploy.yml).
/release/
/bootstrap/deployment.json
